# Supabase 專案 URL (於 Supabase Project Settings -> API 取得)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase 公開金鑰 (anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase 服務金鑰 (service_role secret，僅限後端使用)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 進行 NLP 語意分析的 LLM API Key (例如 Gemini API Key)
LLM_API_KEY=your_llm_api_key

# 設為 "true" 時直接略過 Playwright，強制回傳本地 Mock Dataset
ENABLE_MOCK_FALLBACK="false"

GEMINI_API_KEY="AI_Studio_API_Key"
LLM_MODEL="gemini-3.8-flash"

# 前端一鍵填入測試帳號（供評審快速登入）
NEXT_PUBLIC_DEMO_EMAIL="demo@gmail.com"
NEXT_PUBLIC_DEMO_PASSWORD="Password123!"